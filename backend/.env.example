# No live values belong in this file. Set production variables in the deployment secret store.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
CONTENT_SOURCE=pdf

# Disabled by default. Authentication or database content requires a configured MongoDB URI.
MONGODB_URI=
AUTH_ENABLED=false
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ALLOWED_ORIGINS=
AUTH_ALLOW_INSECURE_LOCALHOST=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_TRUST_PROXY_HOPS=0

# Recovery and verification require auth, replica-set storage, an allowed HTTPS frontend origin,
# and a configured email provider before accounts can complete these flows in production.
PASSWORD_RESET_FRONTEND_URL=
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_FRONTEND_URL=
EMAIL_VERIFICATION_TTL_MINUTES=1440
MAIL_DELIVERY_ENABLED=false
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=

# Explicit feature enablement and operator-managed indexes/permissions are separate steps.
COMMUNITY_POSTING_ENABLED=false
ARTICLE_COVER_IMAGE_ORIGINS=
ADMINISTRATION_ENABLED=false
ANALYTICS_ENABLED=false
ANALYTICS_ALLOWED_ORIGINS=
ANALYTICS_RETENTION_DAYS=180
