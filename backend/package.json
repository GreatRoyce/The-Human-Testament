{
  "name": "backend",
  "description": "Backend API for The Human Testament",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "admin:init": "node scripts/initialize-administration-storage.js",
    "admin:access": "node scripts/provision-administration-access.js",
    "analytics:init": "node scripts/initialize-analytics-storage.js",
    "analytics:role": "node scripts/provision-analytics-role.js",
    "notifications:init": "node scripts/initialize-notification-storage.js",
    "articles:init": "node scripts/initialize-article-storage.js",
    "community:init": "node scripts/initialize-community-storage.js",
    "community:moderator": "node scripts/provision-community-moderator.js",
    "auth:init": "node scripts/initialize-auth-storage.js",
    "content:sync": "node scripts/sync-pdf-content.js",
