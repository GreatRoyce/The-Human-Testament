# PUBLIC configuration only. Every VITE_ variable can become browser-visible.
# pdf uses the verified PDF projection. api requires a configured backend; mock is development-only.
VITE_CONTENT_SOURCE=pdf
# HTTPS backend origin or deployment prefix, WITHOUT /api, credentials, query or fragment.
# May be empty for a public PDF-only build; account/community functions then show configuration errors.
VITE_API_URL=
VITE_ANALYTICS_ENABLED=false
