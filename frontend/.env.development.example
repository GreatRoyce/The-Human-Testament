# Copy these PUBLIC settings to .env for local development.
# The backend must allow http://localhost:5173 and listen on port 5000.
VITE_API_URL=http://localhost:5000
VITE_CONTENT_SOURCE=pdf
VITE_ANALYTICS_ENABLED=false

# For a hosted production build, configure the real HTTPS backend origin
# in Vercel's environment settings. Local .env files are not committed.
